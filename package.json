{
  "name": "opencode-sandbox",
  "version": "0.7.0",
  "description": "OpenCode plugin that sandboxes agent commands using @anthropic-ai/sandbox-runtime (seatbelt on macOS, bubblewrap on Linux)",
  "oc-plugin": [
    "server"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "index.ts",
    "dist",
    "scripts/ssh-http-proxy.mjs",
    "scripts/github-http-bridge.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:plugin": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && bun x tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:smoke": "bun run build:plugin && bun scripts/smoke-v2.ts",
    "test:opencode": "bun run build:plugin && bun scripts/smoke-v2.ts --opencode",
    "release:build": "bun scripts/build-release.ts",
    "lint": "biome lint .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepublishOnly": "bun run build:plugin"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sandbox",
    "security",
    "anthropic",
    "seatbelt",
    "bubblewrap",
    "agent-safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillermoap/opencode-sandbox-plugin.git"
  },
  "homepage": "https://github.com/guillermoap/opencode-sandbox-plugin#readme",
  "bugs": {
    "url": "https://github.com/guillermoap/opencode-sandbox-plugin/issues"
  },
  "author": "Ivan Sanchez <ivan31.sanchez@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76",
    "@opencode/plugin": "2.0.29"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode-ai/plugin": "^1.2.1",
    "@opencode-ai/sdk": "^1.2.1",
    "@types/bun": "^1.3.9",
    "jsonc-parser": "3.3.1",
    "typescript": "^7.0.2"
  }
}
